---
import Section from "../primitives/Section.astro";
import ProjectCard from "./ProjectCard.astro";
import { workProjects } from "../../data/projects";
---

<Section
  id="work"
  title="Engineering in Practice."
  description="Production systems, architecture decisions, and measurable impact."
>
  <div class="grid gap-6 md:grid-cols-2 md:gap-8">
    {workProjects.map((project) => <ProjectCard project={project} />)}
  </div>
</Section>
