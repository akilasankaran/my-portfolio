---
import Section from "../primitives/Section.astro";
import { FadeIn } from "../motion/FadeIn";
import { SocialIconLinks } from "../motion/SocialIconLinks";
import { ContactActions } from "../motion/ContactActions";
import { site } from "../../data/site";
---

<Section id="contact" title={site.contactHeading} description={site.contactCopy}>
  <FadeIn client:visible>
    <ContactActions client:visible email={site.email} />
    <SocialIconLinks
      client:visible
      email={site.email}
      resumeUrl={site.resumeUrl}
      linkedin={site.social.linkedin}
      github={site.social.github}
      className="mt-8"
    />
    <p class="mt-6 text-sm font-medium text-text-secondary">{site.relocationLine}</p>
  </FadeIn>
</Section>
