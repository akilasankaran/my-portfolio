---
import Section from "../primitives/Section.astro";
import { FadeIn } from "../motion/FadeIn";
import { SocialIconLinks } from "../motion/SocialIconLinks";
import { site } from "../../data/site";
---

<Section id="contact" title={site.contactHeading}>
  <FadeIn client:visible>
    <p class="max-w-xl text-base leading-relaxed text-text-secondary md:text-lg">
      {site.contactCopy}
    </p>
    <SocialIconLinks
      client:visible
      email={site.email}
      resumeUrl={site.resumeUrl}
      linkedin={site.social.linkedin}
      github={site.social.github}
      className="mt-8"
    />
    <p class="mt-6 text-sm font-medium text-text-secondary">Open to relocation.</p>
  </FadeIn>
</Section>
