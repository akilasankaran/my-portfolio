---
import Container from "../primitives/Container.astro";
import Section from "../primitives/Section.astro";
import { writing } from "../../data/writing";
---

<Section
  id="writing"
  index="05"
  title="Technical focus"
  description="Themes from recent work: architecture, performance, reliability, and AI tooling."
>
  <Container>
    <ul class="divide-y divide-border-default" role="list">
      {
        writing.map((item) => (
          <li>
            <a
              href={item.href}
              class="group flex flex-col gap-4 py-8 transition-colors sm:flex-row sm:items-start sm:justify-between sm:gap-12 md:py-10"
            >
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="rounded-md bg-accent-muted px-2 py-0.5 font-mono text-xs text-accent">
                    {item.tag}
                  </span>
                  <span class="font-mono text-xs text-text-tertiary">{item.readingTime}</span>
                </div>
                <h3 class="mt-3 text-lg font-semibold text-text-primary transition-colors group-hover:text-accent md:text-xl">
                  {item.title}
                </h3>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-secondary md:text-base">
                  {item.excerpt}
                </p>
              </div>
              <time class="shrink-0 font-mono text-sm text-text-tertiary sm:pt-1">
                {item.date}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
