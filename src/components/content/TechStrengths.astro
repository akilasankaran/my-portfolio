---
import Container from "../primitives/Container.astro";
import Section from "../primitives/Section.astro";
import { StaggerChildren, StaggerItem } from "../motion/StaggerChildren";
import { strengths } from "../../data/strengths";
---

<Section
  id="strengths"
  index="04"
  title="Technical strengths"
  description="Depth across architecture, performance, platform, and leadership, with evidence."
>
  <Container>
    <StaggerChildren client:visible className="grid gap-6 md:grid-cols-2 md:gap-8">
      {
        strengths.map((category) => (
          <StaggerItem>
            <article class="flex h-full flex-col rounded-xl border border-border-default bg-bg-elevated p-6 transition-colors duration-200 hover:border-border-hover md:p-8">
              <h3 class="text-lg font-semibold text-text-primary">{category.category}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-tertiary">
                {category.description}
              </p>
              <ul class="mt-8 flex-1 space-y-5" role="list">
                {category.items.map((item) => (
                  <li>
                    <p class="font-medium text-text-primary">{item.name}</p>
                    <p class="mt-1 text-sm leading-relaxed text-text-secondary">
                      {item.evidence}
                    </p>
                  </li>
                ))}
              </ul>
            </article>
          </StaggerItem>
        ))
      }
    </StaggerChildren>
  </Container>
</Section>
