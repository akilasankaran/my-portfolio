---
import type { SkillIcon } from "../../data/skills";
import { skillGroups, skillsSubtitle } from "../../data/skills";

const iconProps = {
  class: "h-[18px] w-[18px] shrink-0 stroke-[url(#skill-icon-gradient)]",
  fill: "none",
  viewBox: "0 0 24 24",
  "stroke-width": 1.75,
  "aria-hidden": "true",
} as const;

function iconPath(type: SkillIcon) {
  switch (type) {
    case "frontend":
      return "M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z";
    case "architecture":
      return "M12 3l9 5.25v7.5L12 21l-9-5.25v-7.5L12 3zm0 3.5L7.5 9.75v4.5L12 17.5l4.5-3.25v-4.5L12 6.5z";
    case "backend":
      return "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2";
    case "cloud":
      return "M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12";
    case "quality":
      return "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z";
    case "ai":
      return "M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z";
  }
}
---

<div class="mt-16">
  <h3 class="font-heading text-xl font-semibold text-text-primary">Skills</h3>
  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-text-secondary md:text-base">
    {skillsSubtitle}
  </p>

  <svg class="absolute h-0 w-0" aria-hidden="true">
    <defs>
      <linearGradient id="skill-icon-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#8b5cf6"></stop>
        <stop offset="50%" stop-color="#ec4899"></stop>
        <stop offset="100%" stop-color="#06b6d4"></stop>
      </linearGradient>
    </defs>
  </svg>

  <ul class="mt-8 grid list-none grid-cols-1 gap-x-10 gap-y-7 p-0 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-2">
    {
      skillGroups.map((group) => (
        <li class="group rounded-lg transition-colors duration-200 hover:bg-bg-subtle/40 sm:-mx-2 sm:px-2 sm:py-1.5">
          <div class="mb-2.5 flex items-center gap-2">
            <svg {...iconProps}>
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPath(group.icon)} />
            </svg>
            <h4 class="font-mono text-xs uppercase tracking-wider text-text-secondary">{group.category}</h4>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <span class="inline-flex rounded-md border border-border-default bg-white/75 px-2 py-0.5 font-mono text-xs text-text-primary/80 transition-colors duration-200 group-hover:border-border-hover group-hover:text-text-primary">
                {item}
              </span>
            ))}
          </div>
        </li>
      ))
    }
  </ul>
</div>
