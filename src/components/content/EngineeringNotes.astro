---
import Section from "../primitives/Section.astro";
import { NotesFilter } from "../motion/NotesFilter";
import {
  engineeringNotes,
  engineeringNotesDescription,
  engineeringNotesLabel,
} from "../../data/engineeringNotes";
import { site } from "../../data/site";
---

<Section
  id="notes"
  title="Engineering notes."
  label={engineeringNotesLabel}
  description={engineeringNotesDescription}
>
  <NotesFilter client:visible notes={engineeringNotes} />

  <p class="mt-10">
    {
      site.linkedinNotesSeriesUrl ? (
        <a
          href={site.linkedinNotesSeriesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-accent transition-colors hover:text-accent-pink"
        >
          Explore all on LinkedIn →
        </a>
      ) : (
        <span class="text-sm font-medium text-text-tertiary">Explore all on LinkedIn →</span>
      )
    }
  </p>
</Section>
