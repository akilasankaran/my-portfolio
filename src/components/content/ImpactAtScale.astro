---
import Section from "../primitives/Section.astro";
import { impactMetrics } from "../../data/impactMetrics";
---

<Section
  id="impact"
  title="Impact at scale."
  description="A few outcomes from systems I've built and improved."
>
  <div class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
    {
      impactMetrics.map((metric) => (
        <div class="glass rounded-xl p-5 md:p-6">
          <p class="metric-value text-2xl md:text-3xl lg:text-4xl">{metric.value}</p>
          <p class="metric-label mt-2">{metric.label}</p>
        </div>
      ))
    }
  </div>
</Section>
