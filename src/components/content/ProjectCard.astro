---
import type { WorkProject } from "../../data/projects";
import Badge from "../primitives/Badge.astro";
import ImpactHighlight from "../primitives/ImpactHighlight.astro";
import { formatImpact } from "../../utils/formatImpact";

interface Props {
  project: WorkProject;
}

const { project } = Astro.props;
const impacts = project.impact
  ? Array.isArray(project.impact)
    ? project.impact
    : [project.impact]
  : [];
---

<article class="glass flex h-full flex-col rounded-xl p-6 transition-colors duration-300 hover:border-accent/25 md:p-8">
  <div>
    <h3 class="font-heading text-xl font-semibold tracking-tight text-text-primary md:text-2xl">
      {project.title}
    </h3>
    <p class="mt-1.5 font-mono text-[11px] uppercase tracking-wider text-text-tertiary">
      {project.context}
    </p>
  </div>

  {
    impacts.length > 0 && (
      <div class:list={["mt-4", impacts.length > 1 && "grid gap-4 sm:grid-cols-2"]}>
        {impacts.map((impact) => {
          const formatted = formatImpact(impact);
          return <ImpactHighlight value={formatted.value} label={formatted.label} />;
        })}
      </div>
    )
  }

  {
    project.challenge && (
      <div class="mt-2">
        <p class="font-mono text-xs uppercase tracking-wider text-text-tertiary">Challenge</p>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary md:text-base">
          {project.challenge}
        </p>
      </div>
    )
  }

  <div class="mt-4">
    <p class="font-mono text-xs uppercase tracking-wider text-text-tertiary">Built</p>
    <p class="mt-2 text-sm leading-relaxed text-text-secondary md:text-base">{project.built}</p>
  </div>

  <div class="mt-auto flex flex-wrap gap-2 pt-6">
    {project.stack.map((tech) => (
      <Badge class="text-text-tertiary">{tech}</Badge>
    ))}
  </div>
</article>
