---
import Section from "../primitives/Section.astro";
import SkillsSection from "./SkillsSection.astro";
import { site } from "../../data/site";
import { currentlyExploring } from "../../data/skills";
---

<Section id="about" title="Beyond the Code." headerClass="mb-5 md:mb-6">
  <div class="max-w-3xl space-y-5 text-base leading-relaxed text-text-secondary md:text-lg">
    {site.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <SkillsSection />

  <div class="mt-16">
    <h3 class="font-heading text-xl font-semibold text-text-primary">Currently exploring</h3>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        currentlyExploring.map((item) => (
          <div class="rounded-xl border border-border-default/60 bg-bg-subtle/50 p-5">
            <p class="font-medium text-text-primary">{item.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-text-tertiary">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</Section>
