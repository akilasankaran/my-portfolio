---
import { HeroContent } from "../motion/HeroContent";
import { site } from "../../data/site";
---

<HeroContent
  client:load
  greeting={site.heroGreeting}
  name={site.name}
  headline={site.heroHeadline}
  intro={site.heroIntro}
  locationLine={site.heroLocationLine}
  ctaLabel={site.primaryCtaLabel}
  email={site.email}
  resumeUrl={site.resumeUrl}
  linkedin={site.social.linkedin}
  github={site.social.github}
/>
