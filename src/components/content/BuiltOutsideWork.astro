---
import Section from "../primitives/Section.astro";
import Badge from "../primitives/Badge.astro";
import ImpactHighlight from "../primitives/ImpactHighlight.astro";
import { outsideWork } from "../../data/outsideWork";
import { formatImpact } from "../../utils/formatImpact";

const impact = formatImpact(outsideWork.impactMetric);
---

<Section id="outside" title="Built outside work." description={outsideWork.subtitle}>
  <div class="grid gap-6 lg:grid-cols-[1fr_320px] lg:gap-8">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-wider text-text-tertiary">
        {outsideWork.contextLabel}
      </p>
      <h3 class="mt-2 font-heading text-xl font-semibold text-text-primary md:text-2xl">
        {outsideWork.title}
      </h3>

      <div class="mt-5 flex flex-wrap gap-2">
        {outsideWork.stack.map((tech) => (
          <Badge class="text-text-tertiary">{tech}</Badge>
        ))}
      </div>

      <p class="mt-5 max-w-2xl leading-relaxed text-text-secondary">{outsideWork.description}</p>

      {
        (outsideWork.demoUrl || outsideWork.githubUrl) && (
          <div class="mt-5 flex flex-wrap gap-4">
            {
              outsideWork.demoUrl && (
                <a
                  href={outsideWork.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-medium text-accent transition-colors hover:text-accent-pink"
                >
                  Live demo ↗
                </a>
              )
            }
            {
              outsideWork.githubUrl && (
                <a
                  href={outsideWork.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-medium text-accent transition-colors hover:text-accent-pink"
                >
                  GitHub ↗
                </a>
              )
            }
          </div>
        )
      }

      <div class="mt-6">
        <ImpactHighlight value={impact.value} label={impact.label} />
        <p class="mt-2 text-sm leading-relaxed text-text-tertiary">{outsideWork.impactDetail}</p>
      </div>
    </div>

    {
      outsideWork.screenshotUrl && (
        <div class="glass overflow-hidden rounded-xl">
          <img
            src={outsideWork.screenshotUrl}
            alt={`Screenshot of ${outsideWork.title}`}
            class="h-auto w-full object-cover"
            loading="lazy"
          />
        </div>
      )
    }
  </div>
</Section>
