---
import Section from "../primitives/Section.astro";
import Badge from "../primitives/Badge.astro";
import { techStack } from "../../data/stack";
---

<Section
  id="skills"
  title="Skills."
  description="Technologies and platforms I work with."
>
  <div class="grid gap-6 sm:grid-cols-2">
    {
      techStack.map((group) => (
        <div class="glass rounded-xl p-5 md:p-6">
          <div class="mb-4 flex items-baseline justify-between gap-2">
            <h3 class="font-medium text-text-primary">{group.category}</h3>
            <span class="font-mono text-xs text-text-tertiary">
              {String(group.items.length).padStart(2, "0")}
            </span>
          </div>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <Badge>{item}</Badge>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Section>
