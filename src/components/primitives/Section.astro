---
import Container from "./Container.astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  class?: string;
}

const { id, title, description, class: className = "" } = Astro.props;
---

<section
  id={id}
  class:list={["scroll-mt-24 py-20 md:py-28", className]}
  aria-labelledby={`${id}-heading`}
>
  <Container>
    <header class="mb-12 md:mb-16">
      <h2
        id={`${id}-heading`}
        class="font-heading text-balance text-2xl font-semibold tracking-tight text-text-primary md:text-3xl"
      >
        {title}
      </h2>
      {description && (
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-text-secondary md:text-lg">
          {description}
        </p>
      )}
    </header>
    <slot />
  </Container>
</section>
