---
interface Props {
  value: string;
  label: string;
  context?: string;
}

const { value, label, context } = Astro.props;
---

<div class="border-l border-border-default pl-5">
  <p class="tabular-nums text-2xl font-semibold tracking-tight text-text-primary md:text-3xl">
    {value}
  </p>
  <p class="mt-1 font-mono text-xs uppercase tracking-wider text-text-tertiary">{label}</p>
  {context && <p class="mt-2 text-sm text-text-tertiary">{context}</p>}
</div>
